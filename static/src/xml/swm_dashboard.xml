<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="smart_waste_management.SwmDashboard">
        <div class="o_swm_dashboard">
            <div class="swm-dash-header d-flex justify-content-between align-items-center">
                <h2 class="mb-0">Waste Management Dashboard</h2>
                <button class="btn btn-secondary btn-sm"
                        t-on-click="refresh">
                    <i class="fa fa-refresh me-1" role="img"
                       aria-label="Refresh"/> Refresh
                </button>
            </div>

            <div t-if="state.loading" class="swm-dash-loading">
                <i class="fa fa-spin fa-circle-o-notch me-2" role="img"
                   aria-label="Loading"/> Loading…
            </div>

            <div t-else="">
                <!-- KPI tiles -->
                <div class="swm-dash-kpis">
                    <div class="swm-tile swm-tile-total"
                         t-on-click="onKpiTotal">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.total"/>
                        <div class="swm-tile-label">Total Bins</div>
                    </div>
                    <div class="swm-tile swm-tile-ok"
                         t-on-click="onKpiAvailable">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.available"/>
                        <div class="swm-tile-label">Available</div>
                    </div>
                    <div class="swm-tile swm-tile-warn"
                         t-on-click="onKpiNearlyFull">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.nearly_full"/>
                        <div class="swm-tile-label">Nearly Full</div>
                    </div>
                    <div class="swm-tile swm-tile-danger"
                         t-on-click="onKpiFull">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.full"/>
                        <div class="swm-tile-label">Full</div>
                    </div>
                    <div class="swm-tile swm-tile-info"
                         t-on-click="onKpiPending">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.pending"/>
                        <div class="swm-tile-label">Pending Collection</div>
                    </div>
                    <div class="swm-tile swm-tile-muted"
                         t-on-click="onKpiOffline">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.offline"/>
                        <div class="swm-tile-label">Offline</div>
                    </div>
                    <div class="swm-tile swm-tile-primary"
                         t-on-click="onKpiOpenRequests">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.open_requests"/>
                        <div class="swm-tile-label">Open Requests</div>
                    </div>
                    <div class="swm-tile swm-tile-danger"
                         t-on-click="onKpiEscalated">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.escalated"/>
                        <div class="swm-tile-label">Escalated</div>
                    </div>
                    <div class="swm-tile swm-tile-warn"
                         t-on-click="openComplaints">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.complaints_open"/>
                        <div class="swm-tile-label">Open Complaints</div>
                    </div>
                    <div class="swm-tile swm-tile-plain">
                        <div class="swm-tile-num">
                            <t t-esc="state.kpi.avg_response"/>h
                        </div>
                        <div class="swm-tile-label">Avg Response</div>
                    </div>
                    <div class="swm-tile swm-tile-primary"
                         t-on-click="onKpiOpensToday">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.opens_today"/>
                        <div class="swm-tile-label">Bin Opens Today</div>
                    </div>
                    <div class="swm-tile swm-tile-plain">
                        <div class="swm-tile-num">
                            <t t-esc="state.kpi.weight_today"/> kg
                        </div>
                        <div class="swm-tile-label">Weight Today</div>
                    </div>
                    <div class="swm-tile swm-tile-danger"
                         t-on-click="onKpiHeavyToday">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.heavy_today"/>
                        <div class="swm-tile-label">
                            Heavy Dumps (&#8805;<t t-esc="state.heavyThreshold"/>kg)
                        </div>
                    </div>
                    <div class="swm-tile swm-tile-warn"
                         t-on-click="onKpiLapsedSubscriptions">
                        <div class="swm-tile-num"
                             t-esc="state.kpi.subscriptions_lapsed"/>
                        <div class="swm-tile-label">Lapsed Subscriptions</div>
                    </div>
                </div>

                <div class="swm-dash-columns">
                    <!-- Corporation drill-down -->
                    <div class="swm-dash-panel">
                        <h5>Bins by Corporation / Municipality</h5>
                        <table class="table table-sm swm-dash-table">
                            <thead>
                                <tr>
                                    <th>Body</th>
                                    <th class="text-end">Bins</th>
                                    <th class="text-end">Full / Pending</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.byCorporation"
                                    t-as="c" t-key="c.id"
                                    class="swm-dash-row"
                                    t-on-click="() => this.onCorpRow(c.id)">
                                    <td t-esc="c.name"/>
                                    <td class="text-end" t-esc="c.bins"/>
                                    <td class="text-end">
                                        <span t-att-class="c.full ? 'text-danger fw-bold' : ''"
                                              t-esc="c.full"/>
                                    </td>
                                </tr>
                                <tr t-if="!state.byCorporation.length">
                                    <td colspan="3" class="text-muted">
                                        No bins registered yet.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Oldest open requests -->
                    <div class="swm-dash-panel">
                        <h5>Oldest Open Collection Requests</h5>
                        <table class="table table-sm swm-dash-table">
                            <thead>
                                <tr>
                                    <th>Request</th>
                                    <th>Bin</th>
                                    <th>Staff</th>
                                    <th>State</th>
                                    <th class="text-end">Esc.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.recentRequests"
                                    t-as="r" t-key="r.id"
                                    class="swm-dash-row"
                                    t-on-click="() => this.openRequest(r.id)">
                                    <td t-esc="r.name"/>
                                    <td t-esc="r.bin_code"/>
                                    <td t-esc="r.staff_id ? r.staff_id[1] : '—'"/>
                                    <td t-esc="r.state"/>
                                    <td class="text-end">
                                        <span t-att-class="r.escalation_level ? 'text-danger fw-bold' : ''"
                                              t-esc="r.escalation_level"/>
                                    </td>
                                </tr>
                                <tr t-if="!state.recentRequests.length">
                                    <td colspan="5" class="text-muted">
                                        No open requests. 🎉
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Bins pending collection — the detail behind the
                     "Pending Collection" tile. A bin shows here from
                     the moment it's detected full until it's actually
                     emptied, even before/without a request row. -->
                <div class="swm-dash-panel swm-dash-panel-wide">
                    <h5>Bins Pending Collection</h5>
                    <table class="table table-sm swm-dash-table">
                        <thead>
                            <tr>
                                <th>Bin</th>
                                <th>Street</th>
                                <th>Association</th>
                                <th class="text-end">Fill</th>
                                <th>Status</th>
                                <th>Staff</th>
                                <th>Full Since</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.pendingBins"
                                t-as="b" t-key="b.id"
                                class="swm-dash-row"
                                t-on-click="() => this.openBinRecord(b.id)">
                                <td t-esc="b.code"/>
                                <td t-esc="b.street_id ? b.street_id[1] : '—'"/>
                                <td t-esc="b.association_id ? b.association_id[1] : '—'"/>
                                <td class="text-end">
                                    <span t-att-class="b.fill_percentage >= 90 ? 'text-danger fw-bold' : 'fw-bold'"
                                          t-esc="Math.round(b.fill_percentage) + '%'"/>
                                </td>
                                <td t-esc="this.statusLabel(b.status)"/>
                                <td t-esc="b.staff_id ? b.staff_id[1] : '—'"/>
                                <td t-esc="b.full_since || '—'"/>
                            </tr>
                            <tr t-if="!state.pendingBins.length">
                                <td colspan="7" class="text-muted">
                                    No bins pending collection. 🎉
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Who opened bins — the RFID access log, granted taps
                     only, newest first. Answers "who put waste in the
                     bin" directly, with the weight recorded (if the
                     device reported one) right alongside. -->
                <div class="swm-dash-panel swm-dash-panel-wide">
                    <h5>Who Opened Bins</h5>
                    <table class="table table-sm swm-dash-table">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Bin</th>
                                <th>Street</th>
                                <th>Member</th>
                                <th class="text-end">Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.recentAccess"
                                t-as="a" t-key="a.id"
                                class="swm-dash-row"
                                t-on-click="() => this.openAccessLogEntry(a.id)">
                                <td t-esc="a.create_date"/>
                                <td t-esc="a.bin_code"/>
                                <td t-esc="a.street_id ? a.street_id[1] : '—'"/>
                                <td>
                                    <t t-esc="a.holder_name || '—'"/>
                                    <span t-if="a.staff_id"
                                          class="badge bg-info ms-1"
                                          style="font-size:0.65rem;">staff</span>
                                </td>
                                <td class="text-end"
                                    t-esc="a.weight_kg ? a.weight_kg + ' kg' : '—'"/>
                            </tr>
                            <tr t-if="!state.recentAccess.length">
                                <td colspan="5" class="text-muted">
                                    No bin opens recorded yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Heavy dumps — same log, filtered to a single tap at
                     or above the configured threshold. -->
                <div class="swm-dash-panel swm-dash-panel-wide">
                    <h5>
                        Heavy Dumps (&#8805;<t t-esc="state.heavyThreshold"/> kg
                        in one tap)
                    </h5>
                    <table class="table table-sm swm-dash-table">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Bin</th>
                                <th>Street</th>
                                <th>Member</th>
                                <th class="text-end">Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.heavyDumps"
                                t-as="h" t-key="h.id"
                                class="swm-dash-row"
                                t-on-click="() => this.openAccessLogEntry(h.id)">
                                <td t-esc="h.create_date"/>
                                <td t-esc="h.bin_code"/>
                                <td t-esc="h.street_id ? h.street_id[1] : '—'"/>
                                <td t-esc="h.holder_name || '—'"/>
                                <td class="text-end text-danger fw-bold"
                                    t-esc="h.weight_kg + ' kg'"/>
                            </tr>
                            <tr t-if="!state.heavyDumps.length">
                                <td colspan="5" class="text-muted">
                                    No heavy dumps recorded.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>

</templates>
