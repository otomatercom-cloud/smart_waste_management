<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_swm_subscription_payment_list" model="ir.ui.view">
        <field name="name">otm.swm.subscription.payment.list</field>
        <field name="model">otm.swm.subscription.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="payment_date"/>
                <field name="member_id"/>
                <field name="association_id" optional="show"/>
                <field name="plan_name"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="period_end" string="Valid Until"/>
                <field name="recorded_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_swm_subscription_payment_form" model="ir.ui.view">
        <field name="name">otm.swm.subscription.payment.form</field>
        <field name="model">otm.swm.subscription.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="association_id" readonly="1"/>
                            <field name="plan_id"/>
                            <field name="plan_name"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                            <field name="payment_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="recorded_by_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_swm_subscription_payment_search" model="ir.ui.view">
        <field name="name">otm.swm.subscription.payment.search</field>
        <field name="model">otm.swm.subscription.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id"/>
                <field name="plan_name"/>
                <field name="association_id"/>
                <filter string="This Month" name="f_this_month"
                        domain="[('payment_date', '&gt;=',
                                 (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Member" name="gb_member"
                        context="{'group_by': 'member_id'}"/>
                <filter string="Plan" name="gb_plan"
                        context="{'group_by': 'plan_name'}"/>
                <filter string="Association" name="gb_assoc"
                        context="{'group_by': 'association_id'}"/>
                <filter string="Payment Date" name="gb_date"
                        context="{'group_by': 'payment_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_swm_subscription_payment" model="ir.actions.act_window">
        <field name="name">Subscription Payments</field>
        <field name="res_model">otm.swm.subscription.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_this_month': 1}</field>
    </record>

</odoo>
