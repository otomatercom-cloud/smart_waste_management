<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone, dependency-free public page (same reasoning as
         public_bin_page: no website/portal layout dependency, no
         KeyError:'website' risk, works reliably from a QR scan). -->
    <template id="public_bin_details_page" name="Smart Waste: Public Bin Details">
        <t t-set="status_labels"
           t-value="dict(bin._fields['status'].selection)"/>
        <t t-set="is_online" t-value="bin.device_online"/>
        <t t-set="fill_rounded" t-value="round(bin.fill_percentage)"/>
        <t t-set="ring_offset" t-value="326 - (326 * min(100, max(0, fill_rounded)) / 100)"/>
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport"
                      content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex"/>
                <title><t t-out="bin.code"/> — Live Status</title>
                <style>
                    :root {
                        --ink: #0F1720;
                        --surface: #182430;
                        --surface-2: #1F2E3B;
                        --line: #2A3A48;
                        --text: #EDF1F5;
                        --muted: #8CA0B3;
                        --brand: #3DDC97;
                        --ok: #34D399;
                        --warn: #F5B942;
                        --danger: #F2545B;
                        --info: #4DA3E0;
                        --off: #5B6B7A;
                    }
                    * { box-sizing: border-box; }
                    html { -webkit-text-size-adjust: 100%; }
                    body {
                        margin: 0;
                        background: var(--ink);
                        color: var(--text);
                        font-family: -apple-system, BlinkMacSystemFont,
                            "Segoe UI", Roboto, "Helvetica Neue", Arial,
                            sans-serif;
                        line-height: 1.45;
                    }
                    .wrap {
                        max-width: 460px;
                        margin: 0 auto;
                        padding: 20px 18px 40px;
                    }
                    a { color: var(--info); }

                    /* Top bar */
                    .topbar {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        margin-bottom: 22px;
                    }
                    .pulse-wrap {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        font-size: 0.82rem;
                        color: var(--muted);
                        font-weight: 600;
                    }
                    .pulse-dot {
                        width: 8px; height: 8px;
                        border-radius: 50%;
                        background: var(--brand);
                        box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.55);
                        animation: pulse 2s infinite;
                    }
                    @keyframes pulse {
                        0%   { box-shadow: 0 0 0 0 rgba(61,220,151,0.5); }
                        70%  { box-shadow: 0 0 0 8px rgba(61,220,151,0); }
                        100% { box-shadow: 0 0 0 0 rgba(61,220,151,0); }
                    }
                    @media (prefers-reduced-motion: reduce) {
                        .pulse-dot { animation: none; }
                    }
                    .code-chip {
                        font-family: ui-monospace, SFMono-Regular, Menlo,
                            Consolas, monospace;
                        font-size: 0.78rem;
                        letter-spacing: 0.02em;
                        color: var(--text);
                        background: var(--surface-2);
                        border: 1px solid var(--line);
                        border-radius: 6px;
                        padding: 4px 9px;
                    }

                    /* Identity */
                    h1 {
                        font-size: 1.5rem;
                        font-weight: 800;
                        letter-spacing: -0.01em;
                        margin: 0 0 2px;
                    }
                    .subtitle {
                        color: var(--muted);
                        font-size: 0.95rem;
                        margin: 0 0 22px;
                    }

                    /* Hero gauge */
                    .hero {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        padding: 8px 0 26px;
                    }
                    .gauge { position: relative; width: 168px; height: 168px; }
                    .gauge svg { transform: rotate(-90deg); }
                    .gauge-track { fill: none; stroke: var(--surface-2); stroke-width: 12; }
                    .gauge-fill {
                        fill: none;
                        stroke-width: 12;
                        stroke-linecap: round;
                        stroke-dasharray: 326;
                        transition: stroke-dashoffset 1.1s cubic-bezier(.22,.9,.34,1),
                                    stroke .3s ease;
                    }
                    @media (prefers-reduced-motion: reduce) {
                        .gauge-fill { transition: none; }
                    }
                    .gauge-center {
                        position: absolute; inset: 0;
                        display: flex; flex-direction: column;
                        align-items: center; justify-content: center;
                    }
                    .gauge-num {
                        font-size: 2.3rem;
                        font-weight: 800;
                        letter-spacing: -0.02em;
                        line-height: 1;
                    }
                    .gauge-unit { font-size: 1.1rem; font-weight: 700; opacity: .7; }
                    .status-pill {
                        margin-top: 14px;
                        display: inline-flex; align-items: center; gap: 6px;
                        font-size: 0.85rem; font-weight: 700;
                        padding: 6px 14px;
                        border-radius: 999px;
                    }
                    .status-pill .dot { width: 7px; height: 7px; border-radius: 50%; }

                    /* Section rows (plain divided list, not another card) */
                    .section { margin-top: 6px; }
                    .section-head {
                        display: flex; align-items: center; gap: 8px;
                        font-size: 0.78rem; font-weight: 700;
                        color: var(--muted);
                        text-transform: none;
                        margin: 26px 0 10px;
                    }
                    .section-head svg { width: 15px; height: 15px; flex-shrink: 0; }
                    .row {
                        display: flex; justify-content: space-between;
                        align-items: baseline; gap: 12px;
                        padding: 10px 0;
                        border-top: 1px solid var(--line);
                        font-size: 0.94rem;
                    }
                    .row:first-of-type { border-top: 1px solid var(--line); }
                    .row .label { color: var(--muted); flex-shrink: 0; }
                    .row .value { text-align: right; font-weight: 600; }
                    .row .value.mono {
                        font-family: ui-monospace, SFMono-Regular, Menlo,
                            Consolas, monospace;
                        font-size: 0.85rem;
                        font-weight: 500;
                    }
                    .badge-online { color: var(--ok); font-weight: 700; }
                    .badge-offline { color: var(--danger); font-weight: 700; }

                    /* Stat tiles */
                    .stat-grid {
                        display: grid;
                        grid-template-columns: repeat(3, 1fr);
                        gap: 10px;
                        margin-top: 10px;
                    }
                    .stat {
                        background: var(--surface);
                        border: 1px solid var(--line);
                        border-radius: 10px;
                        padding: 14px 10px;
                        text-align: center;
                    }
                    .stat-num { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.01em; }
                    .stat-label { font-size: 0.72rem; color: var(--muted); margin-top: 3px; }
                    .stat.ok .stat-num { color: var(--ok); }
                    .stat.danger .stat-num { color: var(--danger); }

                    .stale-note {
                        margin-top: 14px;
                        font-size: 0.82rem;
                        color: var(--warn);
                        background: rgba(245, 185, 66, 0.1);
                        border: 1px solid rgba(245, 185, 66, 0.25);
                        border-radius: 8px;
                        padding: 10px 12px;
                    }

                    .footer-link {
                        display: block;
                        text-align: center;
                        margin-top: 30px;
                        font-size: 0.85rem;
                        color: var(--muted);
                        text-decoration: none;
                        border-top: 1px solid var(--line);
                        padding-top: 18px;
                    }
                    .footer-link strong { color: var(--info); font-weight: 600; }
                    .powered {
                        text-align: center;
                        color: #4A5A68;
                        font-size: 0.74rem;
                        margin-top: 10px;
                    }
                </style>
            </head>
            <body>
                <div class="wrap">
                    <div class="topbar">
                        <div class="pulse-wrap">
                            <span class="pulse-dot"/>
                            Live status
                        </div>
                        <span class="code-chip"><t t-out="bin.code"/></span>
                    </div>

                    <h1><t t-out="bin.name"/></h1>
                    <p class="subtitle">
                        <t t-if="bin.street_id"><t t-out="bin.street_id.name"/></t>
                        <t t-if="bin.association_id"> · <t t-out="bin.association_id.name"/></t>
                    </p>

                    <div class="hero">
                        <div class="gauge">
                            <svg viewBox="0 0 120 120" width="168" height="168">
                                <circle class="gauge-track" cx="60" cy="60" r="52"/>
                                <circle class="gauge-fill" cx="60" cy="60" r="52"
                                        t-attf-style="stroke: {{ '#F2545B' if fill_rounded >= 90 else ('#F5B942' if fill_rounded >= 70 else '#34D399') }}; stroke-dashoffset: {{ ring_offset }};"/>
                            </svg>
                            <div class="gauge-center">
                                <t t-if="show_fill">
                                    <span class="gauge-num"><t t-out="fill_rounded"/><span class="gauge-unit">%</span></span>
                                </t>
                                <t t-else="">
                                    <span class="gauge-num" style="font-size:1.1rem;">—</span>
                                </t>
                            </div>
                        </div>
                        <span t-attf-class="status-pill"
                              t-attf-style="background: {{ {'available':'rgba(52,211,153,.15)','collected':'rgba(52,211,153,.15)','nearly_full':'rgba(245,185,66,.15)','full':'rgba(242,84,91,.15)','collection_pending':'rgba(242,84,91,.15)','collection_in_progress':'rgba(77,163,224,.15)','offline':'rgba(91,107,122,.18)','maintenance':'rgba(91,107,122,.18)'}.get(bin.status, 'rgba(91,107,122,.18)') }}; color: {{ {'available':'#34D399','collected':'#34D399','nearly_full':'#F5B942','full':'#F2545B','collection_pending':'#F2545B','collection_in_progress':'#4DA3E0','offline':'#8CA0B3','maintenance':'#8CA0B3'}.get(bin.status, '#8CA0B3') }};">
                            <span class="dot" t-attf-style="background: currentColor;"/>
                            <t t-out="status_labels.get(bin.status)"/>
                        </span>
                    </div>

                    <t t-if="not is_online">
                        <div class="stale-note">
                            This bin's sensor hasn't reported in recently.
                            Live fill data below may be out of date.
                        </div>
                    </t>

                    <div class="section-head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M4 10h16"/><path d="M10 4v6"/></svg>
                        Device
                    </div>
                    <div class="row">
                        <span class="label">Connection</span>
                        <span t-attf-class="value {{ 'badge-online' if is_online else 'badge-offline' }}">
                            <t t-if="is_online">Online</t>
                            <t t-else="">Offline</t>
                        </span>
                    </div>
                    <div class="row">
                        <span class="label">Device ID</span>
                        <span class="value mono"><t t-out="bin.device_id or '—'"/></span>
                    </div>
                    <div class="row" t-if="bin.battery_level">
                        <span class="label">Battery</span>
                        <span class="value"><t t-out="round(bin.battery_level)"/>%</span>
                    </div>
                    <div class="row" t-if="bin.last_reading_time">
                        <span class="label">Last reading</span>
                        <span class="value"><t t-out="bin.last_reading_time" t-options="{'widget': 'datetime'}"/></span>
                    </div>

                    <div class="section-head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        Location
                    </div>
                    <div class="row" t-if="bin.street_id">
                        <span class="label">Street</span>
                        <span class="value"><t t-out="bin.street_id.name"/></span>
                    </div>
                    <div class="row" t-if="bin.association_id">
                        <span class="label">Association</span>
                        <span class="value"><t t-out="bin.association_id.name"/></span>
                    </div>
                    <div class="row" t-if="bin.ward_id">
                        <span class="label">Ward</span>
                        <span class="value"><t t-out="bin.ward_id.name"/></span>
                    </div>
                    <div class="row" t-if="bin.corporation_id">
                        <span class="label">Corporation</span>
                        <span class="value"><t t-out="bin.corporation_id.name"/></span>
                    </div>

                    <div class="section-head" t-if="bin.staff_id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="8" r="4"/></svg>
                        Assigned Staff
                    </div>
                    <div class="row" t-if="bin.staff_id">
                        <span class="label">Collector</span>
                        <span class="value"><t t-out="bin.staff_id.name"/></span>
                    </div>
                    <div class="row" t-if="bin.staff_id and bin.staff_id.supervisor_id">
                        <span class="label">Supervisor</span>
                        <span class="value"><t t-out="bin.staff_id.supervisor_id.name"/></span>
                    </div>

                    <div class="section-head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-6 3 3 5-8"/></svg>
                        Collection History
                    </div>
                    <div class="stat-grid">
                        <div class="stat">
                            <div class="stat-num"><t t-out="cycles"/></div>
                            <div class="stat-label">Times collected</div>
                        </div>
                        <div class="stat ok">
                            <div class="stat-num"><t t-out="on_time"/></div>
                            <div class="stat-label">On time</div>
                        </div>
                        <div class="stat danger">
                            <div class="stat-num"><t t-out="breaches"/></div>
                            <div class="stat-label">SLA breaches</div>
                        </div>
                    </div>
                    <div class="row" t-if="last_collected" style="margin-top:4px;">
                        <span class="label">Last collected</span>
                        <span class="value"><t t-out="last_collected.completed_time" t-options="{'widget': 'datetime'}"/></span>
                    </div>

                    <a t-attf-href="/waste/bin/{{ bin.code }}" class="footer-link">
                        See something wrong with this bin?
                        <strong>Report an issue</strong>
                    </a>
                    <div class="powered">Smart Waste Management · Otomater</div>
                </div>
            </body>
        </html>
    </template>

</odoo>
