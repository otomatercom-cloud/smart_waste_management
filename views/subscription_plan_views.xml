<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_swm_subscription_plan_list" model="ir.ui.view">
        <field name="name">otm.swm.subscription.plan.list</field>
        <field name="model">otm.swm.subscription.plan</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="duration_days"/>
                <field name="rate_per_kg" widget="monetary" optional="show"/>
                <field name="member_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_swm_subscription_plan_form" model="ir.ui.view">
        <field name="name">otm.swm.subscription.plan.form</field>
        <field name="model">otm.swm.subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_members" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="member_count" widget="statinfo"
                                   string="Members"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"
                                   placeholder="e.g. Monthly Household"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="duration_days"/>
                            <field name="rate_per_kg" widget="monetary"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Changing the price here only affects future
                        renewals — every past payment keeps the amount
                        that actually applied when it was recorded.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_swm_subscription_plan_search" model="ir.ui.view">
        <field name="name">otm.swm.subscription.plan.search</field>
        <field name="model">otm.swm.subscription.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Active" name="f_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="f_inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_swm_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">otm.swm.subscription.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription plan
            </p>
            <p>Set an amount and a duration — e.g. Monthly ₹100 / 30
               days, Quarterly ₹250 / 90 days. Assign a plan to each
               member; Renew Subscription then uses that plan's price
               and duration automatically.</p>
        </field>
    </record>

</odoo>
